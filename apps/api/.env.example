PORT=3001
DATABASE_URL=postgresql://platform_user:replace_with_a_local_development_password@localhost:5432/cooperative_gig_platform?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_a_32_character_or_longer_local_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_32_character_or_longer_local_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Step 9 — Razorpay (server-side only). Leave unset to run in local/dev without
# live payments. NEVER share the secret or webhook secret with the frontend.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
